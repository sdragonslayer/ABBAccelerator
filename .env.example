# Application
PROOFRAG_APP_NAME=ProofRAG Maintenance Intelligence
PROOFRAG_ENVIRONMENT=development
PROOFRAG_HOST=127.0.0.1
PROOFRAG_PORT=8000
PROOFRAG_DATA_DIR=data
PROOFRAG_DATABASE_PATH=data/proofrag.db
PROOFRAG_MAX_UPLOAD_MB=30
PROOFRAG_ENABLE_OCR=false

# Retrieval
PROOFRAG_DEFAULT_TOP_K=6
PROOFRAG_BM25_WEIGHT=0.60
PROOFRAG_VECTOR_WEIGHT=0.40
PROOFRAG_MIN_QUERY_COVERAGE=0.34
PROOFRAG_MIN_ABSOLUTE_SIMILARITY=0.08
PROOFRAG_EMBEDDING_DIMENSIONS=384

# Answer generation: "extractive" works without external services.
# Use "openai-compatible" with any compatible hosted or local endpoint.
PROOFRAG_ANSWER_PROVIDER=extractive
PROOFRAG_LLM_BASE_URL=https://api.openai.com/v1
PROOFRAG_LLM_API_KEY=
PROOFRAG_LLM_MODEL=
PROOFRAG_LLM_TIMEOUT_SECONDS=45
